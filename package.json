{
  "name": "restore-link-card",
  "version": "3.0.4",
  "description": "A browser extension to restore OGP link cards on Twitter (X)",
  "keywords": [
    "extension",
    "twitter"
  ],
  "homepage": "https://github.com/Robot-Inventor/restore-link-card#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/restore-link-card/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/restore-link-card.git"
  },
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production rspack build",
    "watch": "cross-env NODE_ENV=development rspack build --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ./src ./script ./rspack.config.ts",
    "package": "node ./script/package.ts",
    "version": "npm run build && git add ."
  },
  "devDependencies": {
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/ts-utils": "^0.8.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "@rspack/cli": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "@types/node": "^26.6.2",
    "@types/webextension-polyfill": "^0.12.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "async-query": "^3.0.0",
    "chokidar": "^6.0.0",
    "cross-env": "^10.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.83.0",
    "twi-ext": "^1.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "web-ext": "^10.0.0",
    "webextension-polyfill": "^0.12.0"
  }
}
